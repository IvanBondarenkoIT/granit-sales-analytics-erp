# Django settings
# Local: DEBUG=True. Production (alt): DEBUG=False
DEBUG=True
# Required: generate locally, e.g. python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-generate-with-django

# Database settings (local development — matches docker-compose.yml)
# Copy this file to .env and set real values. Do not commit .env.
DB_NAME=granitanalytics
DB_USER=granit_app
# Required: set a local-only password in .env (never commit real credentials)
DB_PASSWORD=replace-me-local-only
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
# Leave empty locally (uses role search_path). On alt the role analytics already has search_path.
# DB_SEARCH_PATH=analytics,core

ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Open registration for now. Set false on the server when accounts should be invite-only.
ALLOW_REGISTRATION=true

# firebird-db-proxy (ETL). Set real URL/token only in .env — never commit them.
PROXY_API_URL=https://replace-me-proxy-host
PROXY_API_TOKEN=replace-me-proxy-token
PROXY_API_TIMEOUT=60
ETL_SALES_STORE_FIELD=STORGRPID
ETL_PRODUCT_PARAM_ID=2

# --- Alt server (pg-core + Caddy edge) — set by deploy hub in server .env ---
# DEBUG=False
# SECRET_KEY=<unique>
# ALLOWED_HOSTS=analytics.dimkava.ge
# CSRF_TRUSTED_ORIGINS=https://analytics.dimkava.ge
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# DB_HOST=pg-core
# DB_NAME=granit
# DB_USER=analytics
# DB_PASSWORD=<hub>
# DB_PORT=5432
# DB_SSLMODE=disable
# IMAGE_TAG=main
# ALLOW_REGISTRATION=false
